# Edit this file before starting the watcher.

# Required: next config to train.
NEXT_CONFIG=

# Optional: leave empty to derive from config filename.
NEXT_WORK_DIR=

# GPU ids visible to the next job.
GPUS=0,1,2,3

# Distributed settings.
NPROC_PER_NODE=4
MASTER_PORT=29731

# Keep these enabled on this machine; 4-card NCCL can hang without them.
NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1

# Extra cfg-options passed after --cfg-options.
# Example: EXTRA_CFG_OPTIONS="train_dataloader.batch_size=2"
EXTRA_CFG_OPTIONS=

